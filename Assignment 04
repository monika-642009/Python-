from pathlib import Path

def valid_email(email):
    return "@" in email and "." in email.split("@")[-1]

def process_files(folder):
    participants = {}
    errors = []

    for path in Path(folder).glob("*.txt"):
        try:
            with path.open("r", encoding="utf-8") as file:
                for line_no, line in enumerate(file, start=1):
                    fields = line.strip().split(";")

                    if len(fields) != 5:
                        errors.append(
                            f"{path.name}:{line_no} - damaged line"
                        )
                        continue

                    reg, name, dept, email, fee = fields

                    if not valid_email(email):
                        errors.append(
                            f"{path.name}:{line_no} - invalid email"
                        )
                    elif reg in participants:
                        errors.append(
                            f"{path.name}:{line_no} - duplicate {reg}"
                        )
                    else:
                        participants[reg] = {
                            "name": name,
                            "department": dept,
                            "email": email,
                            "fee": fee
                        }

        except FileNotFoundError:
            errors.append(f"{path.name} - file not found")
        except PermissionError:
            errors.append(f"{path.name} - permission denied")

    with open("participants.txt", "w", encoding="utf-8") as out:
        for reg, details in participants.items():
            out.write(
                f"{reg};{details['name']};"
                f"{details['department']};{details['email']};"
                f"{details['fee']}\\n"
            )

    with open("error_log.txt", "w", encoding="utf-8") as out:
        for error in errors:
            out.write(error + "\\n")

    print("Valid registrations:", len(participants))
    print("Errors found:", len(errors))

process_files("department_files")

